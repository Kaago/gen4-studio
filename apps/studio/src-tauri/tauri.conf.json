{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gen4 Studio",
  "version": "../package.json",
  "identifier": "dev.gen4studio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gen4 Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost blob:",
      "devCsp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost blob: ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/apicula",
      "binaries/rotom-lsp"
    ],
    "resources": {
      "licenses/": "licenses/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2QjRDNUNGNUExMjBFMEQKUldRTkRoSmF6OFcwTm9SN3NLY0VCRzFML09iY0pSMDRIZlp6Y2FWZmFIa2RFVXBaTG1qQlVMYU0K",
      "endpoints": ["https://github.com/Kaago/gen4-studio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
