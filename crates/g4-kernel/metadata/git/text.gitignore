# Gen4 Studio, Textprojekt. Enthält Daten aus dem Spiel: nur lokal oder privat versionieren, nie öffentlich.
# Zum Teilen: Technik › Veröffentlichen (Patch gegen die Basis-ROM).

# Gebaute ROMs und Patches
*.nds
*.srl
*.xdelta
/build/

# Emulator: Spielstände und Savestates
*.sav
*.dsv
*.ml[0-9]
*.mln
*.state

# Studio: nur base.json, preview.png und releases.json sind Projekt, der Rest ist lokal
/.g4/*
!/.g4/base.json
!/.g4/preview.png
!/.g4/releases.json

# Spieldateien: aus der Basis-ROM und dem Textprojekt erzeugt (nach einem Klon: „Textprojekt vervollständigen“)
{{dspre_part}}

# rotom: nur die Befehlsdatenbank ist Projekt (die Quirks stehen in data/rotom-quirks.json)
/.rotom/*
!/.rotom/command_database
# Erzeugte ID-Dateien für rotom, das Studio schreibt sie neu
/.rotom/command_database/.g4-ids-*

# Sicherungen neben data/ würden beim Export Blobs unter data/raw/: nicht im Projektordner sichern
*.bak
*.orig
*~
/*.prev
/*.prev/

.DS_Store
Thumbs.db
