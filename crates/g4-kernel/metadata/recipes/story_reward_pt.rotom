script belohnung_{local_id}_{n} #{n}:
    LockAll
    FacePlayer
    if {var} >= {from} then
        if {flag} == 0 then
            Message {message}
            WaitButton
            CloseMessage
            GiveItem {item}, 1, VAR_RESULT
            SetFlag {flag}
            ReleaseAll
            End
        endif
    endif
    ReleaseAll
{tail}
